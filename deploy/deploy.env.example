# Copy to deploy/deploy.env and edit. deploy.env is gitignored — put
# site-specific values (proxies, hosts, paths) there, never in this file.
#
#   cp deploy/deploy.env.example deploy/deploy.env

# ---- image and container -----------------------------------------------------
#IMAGE=localhost/jabaws:latest
#CONTAINER_NAME=jabaws
#HOST_PORT=8080

# Prefix for the four named volumes: <prefix>-logs, -jobsout, -stats,
# -stats-backups. Change it to run more than one instance on a host.
#VOLUME_PREFIX=jabaws

# ---- systemd -----------------------------------------------------------------
# user   -> ~/.config/containers/systemd  (rootless; needs lingering to survive logout)
# system -> /etc/containers/systemd       (needs root)
#QUADLET_SCOPE=user

# Unit name. Change if a hand-written jabaws.service already exists on the host —
# units in /etc/systemd/system take precedence over generated ones and would
# silently shadow this. See deploy/README.md.
#UNIT_NAME=jabaws

# ---- proxy -------------------------------------------------------------------
# Left unset, the script uses whatever http_proxy/https_proxy are already in the
# environment and exports the uppercase forms for the build.
#HTTP_PROXY=http://proxy.example.org:3128
#HTTPS_PROXY=http://proxy.example.org:3128

# Hosts to reach directly. localhost is always included.
#NO_PROXY_EXTRA=internal.example.org

# Set when the proxy cannot route to the WAR host and the download must bypass
# it. Leave unset first — the script tells you if the proxied fetch fails.
#WAR_NOPROXY=1

# ---- dependency sources ------------------------------------------------------
#WAR_URL=http://www.compbio.dundee.ac.uk/jabaws22/archive/jabaws.war
#PYTHON_URL=https://www.python.org/ftp/python/2.7.13/Python-2.7.13.tgz
# Savannah gitweb 502s through some proxies; the gcc mirror serves the same files.
#CONFIG_GUESS_URL=https://raw.githubusercontent.com/gcc-mirror/gcc/master/config.guess
#CONFIG_SUB_URL=https://raw.githubusercontent.com/gcc-mirror/gcc/master/config.sub

# ---- build -------------------------------------------------------------------
#BUILD_LOG_DIR=./build-logs
# Minimum free space on the build filesystem, in GB.
#MIN_FREE_GB=20
