# Quadlet unit for JABAWS. Generated from deploy/jabaws.container.in by
# deploy/podman-deploy.sh — edit the template, not the installed copy.
#
# systemd generates @UNIT_NAME@.service from this file at daemon-reload.
# Manage it with systemctl, never with podman start/stop.

[Unit]
Description=JABAWS bioinformatics web services
After=network-online.target
Wants=network-online.target

[Container]
Image=@IMAGE@
ContainerName=@CONTAINER_NAME@
PublishPort=@HOST_PORT@:8080

# Named volumes are seeded from the image on first use, which matters for the
# statistics database — a bind mount would present Derby an empty directory.
Volume=@VOLUME_PREFIX@-logs:/usr/local/tomcat/logs:Z
Volume=@VOLUME_PREFIX@-jobsout:/usr/local/tomcat/webapps/jabaws/jobsout:Z
Volume=@VOLUME_PREFIX@-stats:/usr/local/tomcat/webapps/jabaws/ExecutionStatistic:Z
Volume=@VOLUME_PREFIX@-stats-backups:/usr/local/tomcat/stats-backups:Z

# The registry warm-up runs every tool once after start; it is backgrounded, so
# it does not delay readiness. Set to 0 to skip it (Jalview then discovers
# nothing until testAllServices is called by hand).
Environment=JABAWS_WARMUP=1

[Service]
Restart=always
# The warm-up and Tomcat's first deploy can take a while on a slow host.
TimeoutStartSec=900

[Install]
WantedBy=@WANTED_BY@
